[Unit]
Description=VPN per-identity traffic collector
After=network-online.target xray.service
Wants=network-online.target

[Service]
Type=simple
User=vpn-traffic
Group=vpn-traffic
ExecStart=/usr/bin/vpn-traffic collector
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
UMask=0077
RuntimeDirectory=vpn-traffic
RuntimeDirectoryMode=0700
StateDirectory=vpn-traffic
StateDirectoryMode=0700
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_UNIX
ReadWritePaths=/var/lib/vpn-traffic /run/vpn-traffic
MemoryMax=64M
TasksMax=32

[Install]
WantedBy=multi-user.target
